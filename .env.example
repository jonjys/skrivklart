# Skrivklart environment template. Copy to .env locally; set real values in
# Vercel → Project → Settings → Environment Variables. Never commit secrets.

# --- Production (Vercel) ---
# Stripe secret key (sk_live_… / sk_test_…). Required for checkout and for
# signing unlock passes. Without it, payments are off (local preview mode).
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# xAI key for document generation. Without it, built-in templates are used.
XAI_API_KEY=
# Postgres (Neon). Optional: without it an in-memory PGlite is used.
DATABASE_URL=

# --- Build-time branding (optional, injected by the platform) ---
VITE_OG_SERVICE_URL=
VITE_PROJECT_ID=
VITE_PUBLIC_HOSTNAME=
X_CREATOR=
X_CREATOR_ID=

# --- Local QA scripts only (never needed on Vercel) ---
BROWSER_ALLOW_EXTERNAL_HOST=
BROWSER_SMOKE_TIMEOUT_MS=
PREVIEW_READY_TIMEOUT_MS=
PREVIEW_THUMBNAIL_TIMEOUT_MS=
